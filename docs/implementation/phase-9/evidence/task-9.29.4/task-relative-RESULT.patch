+  "throwBefore",
+  "abort",
+  "abortLost",
+  "abortMissingAck",
+  "throwAfter",
+  "missingAck",
+  "readFailure",
+  "missingFact",
+  "extraFact",
+  "mismatchedFact",
+] as const)("realization physical certainty: %s", async (fault) => {
+  const f = await retained(),
